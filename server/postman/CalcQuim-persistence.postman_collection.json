            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runTag', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => { if (pm.response.code !== 200) throw new Error('Estado inesperado'); });",
              "const value = pm.response.json();",
              "if (Number.isInteger(value.revision)) pm.collectionVariables.set('revision', String(value.revision));",
              "if (value.generation) pm.collectionVariables.set('generation', value.generation);"
            ]
          }
        }
      ]
