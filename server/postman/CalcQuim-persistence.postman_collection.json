{
  "info": {
    "name": "CalcQuim persistencia ? solo sint?ticos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con Express start:sandbox. Crea datos sint?ticos con nombres ?nicos. No contiene credenciales. No usar para importar respaldos reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method !== 'GET') {",
          "pm.request.headers.upsert({key:'X-CalcQuim-Mode',value:'synthetic'});",
          "pm.request.headers.upsert({key:'If-Match',value:pm.collectionVariables.get('revision') || ''});",
          "pm.request.headers.upsert({key:'X-Dataset-Generation',value:pm.collectionVariables.get('generation') || ''});",
          "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Dataset sint?tico",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/dataset",
