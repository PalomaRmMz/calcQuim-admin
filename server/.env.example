# Plantilla pública SIN credenciales. Copiar manualmente a .env.development.
# No se crea ni carga ninguna base automáticamente.
PORT=3001
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=calcquim_dev
PGUSER=calcquim_app
PGPASSWORD=
PGCONNECT_TIMEOUT_MS=1500
PGQUERY_TIMEOUT_MS=1500
# Para .env.test: NODE_ENV=test, PORT=3002, PGDATABASE=calcquim_test,
# PGUSER=calcquim_app_test y una contraseña privada diferente.
